<odoo>
    <record id="action_movedate_log" model="ir.actions.act_window">
        <field name="name">Move Date Logs</field>
        <field name="res_model">movedate.log</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_movedate_log_tree" model="ir.ui.view">
        <field name="name">movedate.log.tree</field>
        <field name="model">movedate.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="change_date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="old_date"/>
                <field name="new_date"/>
            </tree>
        </field>
    </record>
</odoo>
